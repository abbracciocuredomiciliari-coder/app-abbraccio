PORT=4000
MONGODB_URI=mongodb://localhost:27017/app-abbraccio
# SICUREZZA: usare una stringa casuale di almeno 64 caratteri
# Generare con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=modifica_con_una_chiave_sicura_di_almeno_64_caratteri

# Cloudinary — storage persistente per gli allegati della cartella clinica
# Registrati gratis su https://cloudinary.com e copia le credenziali dal dashboard
CLOUDINARY_CLOUD_NAME=il_tuo_cloud_name
CLOUDINARY_API_KEY=la_tua_api_key
CLOUDINARY_API_SECRET=il_tuo_api_secret

# Email notifiche — configurazione SMTP
# Esempio con Aruba (hosting email classico, NON PEC):
#   SMTP_HOST=smtps.aruba.it
#   SMTP_PORT=465  (SSL/TLS)
#   SMTP_USER=info@abbracciocuredomiciliari.it
#   SMTP_PASS=password_dell_account_aruba
#
# Per PEC @aruba.it: SMTP_HOST=smtps.pec.aruba.it, SMTP_PORT=465
#
# IMPORTANTE: impostare queste variabili anche su Render dashboard → Environment
ADMIN_EMAIL=info@abbracciocuredomiciliari.it
# Mittente visibile nelle email (se diverso da SMTP_USER)
FROM_EMAIL=info@abbracciocuredomiciliari.it
SMTP_HOST=smtps.aruba.it
# 465 = SSL/TLS
SMTP_PORT=465
SMTP_USER=info@abbracciocuredomiciliari.it
SMTP_PASS=password_aruba_info
FRONTEND_URL=https://app.abbracciocuredomiciliari.it

# Groq AI — Speech-to-Text + LLM per dettatura vocale nel diario clinico
# Ottieni una chiave gratuita su https://console.groq.com
GROQ_API_KEY=gsk_tua_chiave_groq
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.3-70b-versatile
