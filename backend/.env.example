PORT=4000
MONGODB_URI=mongodb://localhost:27017/app-abbraccio
JWT_SECRET=modifica_con_una_chiave_sicura

# Cloudinary — storage persistente per gli allegati della cartella clinica
# Registrati gratis su https://cloudinary.com e copia le credenziali dal dashboard
CLOUDINARY_CLOUD_NAME=il_tuo_cloud_name
CLOUDINARY_API_KEY=la_tua_api_key
CLOUDINARY_API_SECRET=il_tuo_api_secret

# Email notifiche admin — configurazione SMTP
# Esempio con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# Usare una "App Password" di Google (non la password normale)
ADMIN_EMAIL=email_admin@esempio.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tua_email@gmail.com
SMTP_PASS=tua_app_password_gmail
